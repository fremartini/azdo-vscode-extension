{
  "name": "azdo-monitor",
  "displayName": "azdo_monitor",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azdoMonitor",
          "title": "AzDO Monitor",
          "icon": "resources/azdo-monitor.svg"
        }
      ]
    },
    "views": {
      "azdoMonitor": [
        {
          "id": "azdoMonitor.pullRequests",
          "name": "Pull Requests",
          "icon": "resources/azdo-monitor.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "azdoMonitor.pullRequests",
        "contents": "No pull requests are being tracked.\n[Register Pull Request](command:azdo-monitor.registerPullRequest)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "azdo-monitor.registerPullRequest",
          "when": "view == azdoMonitor.pullRequests",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "azdo-monitor.registerPullRequest",
        "title": "Register Pull Request",
        "icon": "$(add)"
      },
      {
        "command": "azdo-monitor.unregisterPullRequest",
        "title": "Unregister Pull Request"
      },
      {
        "command": "azdo-monitor.signIn",
        "title": "Sign in to Azure DevOps",
        "category": "AzDO Monitor",
        "icon": "$(account)"
      }
    ],
    "configuration": {
      "title": "AzDO Monitor",
      "properties": {
        "azdoMonitor.tenantId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Microsoft Entra tenant ID (GUID or domain, e.g. `contoso.onmicrosoft.com`) used to sign in to Azure DevOps. Leave empty to use your account's default tenant; set it when your account belongs to several tenants and the organization is not in the default one."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}